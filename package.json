{
  "name": "workmate",
  "version": "0.1.0",
  "private": true,
  "description": "A proactive desktop work assistant",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n renderer,electron -c cyan,magenta \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "tsc -p tsconfig.electron.json && wait-on tcp:5173 && cross-env WORKMATE_BACKEND_MODE=development electron .",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.electron.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "lint": "eslint . --ext ts,tsx --max-warnings 0",
    "backend:dev": "cd backend && python3 -m uvicorn server.main:app --reload --port 8765",
    "backend:test": "cd backend && python3 -m pytest",
    "start": "electron .",
    "package:mac": "npm run build && electron-builder --mac",
    "package:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "latest",
    "cross-env": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "eslint": "latest",
    "@eslint/js": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vite": "latest",
    "wait-on": "latest"
  },
  "build": {
    "appId": "com.workmate.desktop",
    "productName": "workMate",
    "directories": { "output": "release" },
    "files": ["dist/**", "dist-electron/**", "package.json", "backend/**", "!backend/.venv/**", "!backend/data/*.db*"],
    "asarUnpack": ["backend/**"],
    "mac": { "category": "public.app-category.productivity" },
    "win": { "target": "nsis" }
  }
}
